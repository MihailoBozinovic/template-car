# Apache (cPanel, većina deljenih hostinga u Srbiji). Ide u koren sajta zajedno sa dist/.

Options -Indexes -MultiViews
DirectoryIndex index.html
# Bez automatskog dodavanja „/” na fascikle — adrese su /cenovnik, ne /cenovnik/
DirectorySlash Off
ErrorDocument 404 /404.html

# HTTPS i bez „www” ↔ „www” — otkomentariši JEDNO, prema domenu iz salon.js
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# /cenovnik/ → /cenovnik (adrese bez kose crte na kraju, kao u sitemap-u)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !^/(en|ru)?/?$
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [L,R=301]
# /cenovnik → /cenovnik/index.html
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ $1/index.html [L]

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain application/manifest+json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Fajlovi sa heš-om u imenu (assets/) se nikad ne menjaju
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
